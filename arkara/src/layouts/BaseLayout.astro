---
import "../styles/global.css";
import "../styles/theme.css";
import SeoHead from "../components/layout/SeoHead.astro";
import DesktopHeader from "../components/layout/DesktopHeader.astro";
import MobileBottomNav from "../components/layout/MobileBottomNav.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";

type CachePolicy = "public" | "private" | "none";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalHref?: string;
  siteName?: string;
  type?: "website" | "article";
  robots?: string;
  preloadImage?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  cachePolicy?: CachePolicy;
}

const {
  title,
  description,
  image,
  imageAlt,
  canonicalHref,
  siteName,
  type,
  robots,
  preloadImage,
  structuredData,
  cachePolicy = "public",
} = Astro.props;

const currentPath = Astro.url.pathname;

if ((Astro.response.status ?? 200) < 300) {
  Astro.response.headers.set("Content-Type", "text/html; charset=utf-8");

  if (cachePolicy === "public") {
    const publicCacheControl =
      "public, max-age=0, s-maxage=600, stale-while-revalidate=86400";
    Astro.response.headers.set("Cache-Control", publicCacheControl);
    Astro.response.headers.set("CDN-Cache-Control", publicCacheControl);
  } else if (cachePolicy === "private") {
    Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
    Astro.response.headers.set("CDN-Cache-Control", "no-store");
  }
}
---
<!doctype html>
<html lang="id" data-theme="dark">
  <head>
    <meta name="theme-color" content="#10251a" />
    <script is:inline>
      // Apply the saved choice before content paints; dark is the site default.
      (() => {
        let theme = 'dark';
        try {
          const saved = localStorage.getItem('arkara-theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch { /* The default remains usable when storage is blocked. */ }
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#10251a' : '#f8f5ec');
      })();
    </script>
    <SeoHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      canonicalHref={canonicalHref}
      siteName={siteName}
      type={type}
      robots={robots}
      preloadImage={preloadImage}
      structuredData={structuredData}
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Langsung ke konten</a>
    <DesktopHeader />
    <MobileBottomNav currentPath={currentPath} />
    <main id="main-content" tabindex="-1">
<slot />
</main>
    <SiteFooter />
  </body>
</html>
