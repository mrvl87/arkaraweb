---
/**
 * PostLayout.astro - Retro Survival Manual 2.0
 * Props: unchanged (backward compatible with blog/[slug] and panduan/[slug])
 * Changes:
 *   - Removed rounded-3xl/shadow-2xl/gradient-br modern aesthetics
 *   - Header: dark ink bg + muted gradient, mono section label
 *   - Content area: paper bg, ink border + shadow (card-ink style)
 *   - Sidebar: dark panel, terminal feel
 *   - TOC: mono font, ink borders
 */
import BaseLayout from './BaseLayout.astro';
import OptimizedImage from '../components/ui/OptimizedImage.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import { calculateReadingTime } from '../lib/markdown';
import { rewriteMediaUrl } from '../lib/media';

interface Props {
  title: string;
  description?: string;
  publishDate?: string;
  category?: string;
  coverImage?: any;
  headings?: any[];
  content?: string;
  currentSlug?: string;
  canonicalHref?: string;
  contentType?: 'blog' | 'panduan';
  quickAnswer?: string | null;
  keyTakeaways?: string[];
  faq?: Array<{ question: string; answer: string }>;
  editorialFormat?: 'legacy' | 'mobile_reader' | 'technical_guide';
}

const {
  title,
  description,
  publishDate,
  category,
  coverImage,
  headings = [],
  content = '',
  currentSlug,
  canonicalHref,
  contentType,
  quickAnswer,
  keyTakeaways = [],
  faq = [],
  editorialFormat = 'legacy',
} = Astro.props;
const readingTime = calculateReadingTime(content);
const cleanQuickAnswer = quickAnswer?.trim();
const cleanTakeaways = keyTakeaways.map((item) => item?.trim()).filter(Boolean);
const cleanFaq = faq
  .map((item) => ({
    question: item.question?.trim(),
    answer: item.answer?.trim(),
  }))
  .filter((item) => item.question && item.answer);
const isTechnicalGuide = editorialFormat === 'technical_guide';
const readerLabel = isTechnicalGuide ? 'Prosedur Cepat' : 'Jawaban Singkat';
const takeawayLabel = isTechnicalGuide ? 'Checklist Lapangan' : 'Inti Artikel';
const tocLabel = isTechnicalGuide ? 'Urutan Prosedur' : 'Isi Artikel';
const siteUrl = 'https://arkaraweb.com';

function resolveSocialImage(image: any): string | undefined {
  if (!image) return undefined;
  if (typeof image === 'string') return image;

  return image.formats?.lg
    || image.formats?.original
    || image.formats?.md
    || image.url
    || image.src
    || undefined;
}

function toAbsoluteSiteUrl(pathOrUrl?: string): string | undefined {
  if (!pathOrUrl) return undefined;

  try {
    return new URL(pathOrUrl, siteUrl).href;
  } catch {
    return undefined;
  }
}

function cleanSchemaText(value?: string | null): string | undefined {
  const cleaned = value
    ?.replace(/<[^>]*>/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[#*_`>~|-]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  return cleaned || undefined;
}

const ogImageUrl = resolveSocialImage(coverImage);
const ogImageAlt = typeof coverImage === 'string'
  ? title
  : coverImage?.alt_text || title;
const readerType = contentType === 'panduan' ? 'panduan' : 'blog';
const readerHref = canonicalHref || (currentSlug ? `/${readerType === 'panduan' ? 'panduan' : 'blog'}/${currentSlug}` : '#');
const articleUrl = toAbsoluteSiteUrl(canonicalHref || readerHref);
const schemaImageUrl = ogImageUrl ? toAbsoluteSiteUrl(rewriteMediaUrl(ogImageUrl)) : undefined;
const schemaDescription = cleanSchemaText(description || cleanQuickAnswer || content)?.slice(0, 320);
const schemaArticle = {
  '@context': 'https://schema.org',
  '@type': contentType === 'panduan' ? 'TechArticle' : 'BlogPosting',
  headline: title,
  description: schemaDescription,
  mainEntityOfPage: articleUrl,
  url: articleUrl,
  image: schemaImageUrl ? [schemaImageUrl] : undefined,
  datePublished: publishDate,
  dateModified: publishDate,
  author: {
    '@type': 'Organization',
    name: 'Arkara',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Arkara',
    url: siteUrl,
  },
  articleSection: category,
  keywords: cleanTakeaways.length ? cleanTakeaways : undefined,
};
const schemaFaq = cleanFaq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: cleanFaq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
const howToSteps = headings
  .filter((heading) => heading.depth === 2 && heading.text && heading.slug)
  .slice(0, 12);
const schemaHowTo = contentType === 'panduan' && isTechnicalGuide && howToSteps.length >= 2
  ? {
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: title,
      description: schemaDescription,
      image: schemaImageUrl,
      step: howToSteps.map((heading, index) => ({
        '@type': 'HowToStep',
        position: index + 1,
        name: heading.text,
        url: articleUrl ? `${articleUrl}#${heading.slug}` : undefined,
      })),
    }
  : null;
const structuredData = [schemaArticle, schemaFaq, schemaHowTo]
  .filter((item) => item !== null) as Record<string, unknown>[];
const readerImageUrl = ogImageUrl ? rewriteMediaUrl(ogImageUrl, { width: 240, quality: 70 }) : undefined;
const readerMeta = {
  id: `${readerType}:${currentSlug || title}`,
  type: readerType,
  slug: currentSlug || '',
  title,
  href: readerHref,
  image: readerImageUrl,
  category,
  readingTime,
};
const readerMetaJson = JSON.stringify(readerMeta).replace(/</g, '\\u003c');

---

<BaseLayout title={title} description={description} image={ogImageUrl} imageAlt={ogImageAlt} preloadImage={ogImageUrl} canonicalHref={canonicalHref} type="article" structuredData={structuredData}>
 <header class="article-header site-container">
  <nav class="article-breadcrumb" aria-label="Breadcrumb"><a href="/">Beranda</a><span>/</span><a href={contentType==='panduan'?'/panduan':'/blog'}>{contentType==='panduan'?'Panduan':'Jurnal'}</a>{category&&<><span>/</span><span>{category}</span></>}</nav>
  <div class="eyebrow">{isTechnicalGuide?'PANDUAN PRAKTIS':'PENGETAHUAN UNTUK HIDUP TANGGUH'}</div>
  <h1>{title}</h1>
  {description&&<p class="article-description">{description}</p>}
  <div class="article-meta"><span class="author-avatar">A</span><strong>Tim Redaksi Arkara</strong>{publishDate&&<time datetime={publishDate}>{new Date(publishDate).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'})}</time>}<span>{readingTime} menit baca</span></div>
 </header>
 <div class="site-container article-layout">
  <article class="article-main" data-reader-card data-reader-id={readerMeta.id} data-reader-type={readerType} data-reader-slug={currentSlug||''} data-reader-title={title} data-reader-href={readerHref} data-reader-image={readerImageUrl||''} data-reader-category={category||''}>
   {coverImage&&<div class="article-cover"><OptimizedImage image={coverImage} alt={title} class="w-full object-cover" aspectRatio="aspect-video" loading="eager" fetchpriority="high" sizes="(max-width: 800px) 100vw, 760px" targetWidths={[640,960,1200]} mobileTargetWidths={[400,640,800]} mobileMaxSrcSetWidth={800} quality={78}/></div>}
   <div class="article-tools"><span>Pengetahuan yang layak disimpan.</span><button type="button" class="article-save reader-save-button" data-reader-save aria-label="Simpan artikel" aria-pressed="false"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 3h12v19l-6-4-6 4V3Z"/></svg><span>Simpan</span></button></div>
   {cleanQuickAnswer&&<section class="article-summary" aria-label={readerLabel}><div class="eyebrow">{readerLabel}</div><p>{cleanQuickAnswer}</p></section>}
   {cleanTakeaways.length>0&&<details class="article-takeaways"><summary>{takeawayLabel}<span>Ringkasan untuk Anda</span></summary><ol>{cleanTakeaways.map(item=><li>{item}</li>)}</ol></details>}
   {headings.length>0&&<details class="article-mobile-toc"><summary>{tocLabel}</summary><TableOfContents headings={headings} compact /></details>}
   <div class="prose-arkara"><slot/></div>
   {cleanFaq.length>0&&<section class="article-faq" aria-labelledby="faq-title"><div class="eyebrow">PERTANYAAN YANG SERING MUNCUL</div><h2 id="faq-title">Masih ingin tahu?</h2>{cleanFaq.map(item=><details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>}
   <div class="article-end"><span class="author-avatar">A</span><div><span class="eyebrow">DISIAPKAN OLEH</span><strong>Tim Redaksi Arkara</strong><p>Berbagi pengetahuan untuk keluarga yang lebih tangguh.</p></div></div>
   <a class="text-link" href={contentType==='panduan'?'/panduan':'/blog'}>← Kembali ke {contentType==='panduan'?'panduan':'jurnal'}</a>
   {currentSlug&&contentType&&<RelatedPosts currentSlug={currentSlug} category={category} contentType={contentType}/>}
  </article>
  <aside class="article-sidebar"><div class="article-sidebar-sticky">{headings.length>0&&<TableOfContents headings={headings}/>}<div class="reader-buddy"><img src="/brand/arkara-guide.webp" alt="" width="85" height="113" loading="lazy"/><div class="eyebrow">TEMAN BERSIAP ANDA</div><h2>Pengetahuan jadi tindakan.</h2><p>Satu langkah kecil hari ini bisa membuat keluarga lebih siap esok hari.</p><a href="/panduan" class="text-link">Temukan panduan →</a></div></div></aside>
 </div>
 <script is:inline id="arkara-reader-meta" type="application/json" set:html={readerMetaJson}></script>
 <script>
  import {trackCurrentReaderContent,initializeReaderBookmarks} from '../lib/reader-state';
  const meta=document.getElementById('arkara-reader-meta');
  if(meta?.textContent){try{trackCurrentReaderContent(JSON.parse(meta.textContent));}catch{/* Reading remains available when storage is unavailable. */}}
  initializeReaderBookmarks();
 </script>
</BaseLayout>
<style>
.article-header{padding-block:35px 35px}.article-breadcrumb{display:flex;gap:10px;flex-wrap:wrap;color:var(--text-muted);font-size:.78rem;margin-bottom:28px}.article-breadcrumb a:hover{text-decoration:underline}.article-header h1{max-width:1040px;font-size:clamp(2.1rem,4.1vw,3.5rem);line-height:1.25;letter-spacing:-.04em;text-wrap:pretty;margin-top:17px}.article-description{font-size:1.15rem;line-height:1.75;color:var(--text-muted);max-width:840px;margin-top:24px}.article-meta{display:flex;align-items:center;flex-wrap:wrap;gap:10px 18px;font-size:.81rem;color:var(--text-muted);margin-top:28px}.article-meta strong{color:var(--forest);font-weight:650}.author-avatar{width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border-radius:50%;background:var(--forest);color:var(--surface);font:800 1rem var(--font-display);flex-shrink:0}
.article-layout{display:grid;grid-template-columns:minmax(0,780px) minmax(0,270px);justify-content:space-between;gap:60px;align-items:start;padding-bottom:75px}.article-main{min-width:0}.article-cover{overflow:hidden;border-radius:10px}.article-cover>div{aspect-ratio:16/9}.article-cover :global(img){width:100%;height:100%;object-fit:cover}.article-tools{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 0 22px;font-size:.78rem;color:var(--text-muted)}.article-save{display:flex;align-items:center;gap:8px;min-height:42px;border:1px solid var(--line);padding:8px 14px;border-radius:6px;color:var(--forest);background:var(--surface-raised);font-size:.8rem}.article-save.is-saved{background:var(--amber-soft);border-color:#dfbd77}.article-save.is-saved svg{fill:var(--amber)}
.article-summary{border-left:3px solid var(--amber);padding:24px 26px;background:var(--forest-soft);border-radius:0 8px 8px 0;margin:8px 0 26px}.article-summary .eyebrow{font-size:.65rem}.article-summary p{font-size:1rem;line-height:1.8;color:#3e5038;margin-top:13px}.article-takeaways{border:1px solid var(--line);border-radius:7px;padding:17px 22px;margin:25px 0}.article-takeaways summary{cursor:pointer;color:var(--forest);font-weight:700;font-size:1rem}.article-takeaways summary span{font-weight:400;color:var(--text-muted);font-size:.8rem;margin-left:15px}.article-takeaways ol{margin:20px 0 0;padding-left:22px;display:grid;gap:14px;font-size:1rem;color:var(--ink-light)}.article-takeaways li::marker{color:var(--forest);font-weight:700}
.article-mobile-toc{display:none}.article-sidebar-sticky{position:sticky;top:110px}.article-sidebar{height:100%;min-width:0}.reader-buddy{margin-top:25px;border:1px solid var(--line);border-radius:9px;padding:25px;background:#edf0e4}.reader-buddy img{height:105px;width:auto;margin-bottom:17px}.reader-buddy .eyebrow{font-size:.55rem}.reader-buddy h2{font-size:1.3rem;line-height:1.4;margin-top:12px}.reader-buddy p{font-size:.88rem;color:var(--text-muted);margin:12px 0}.reader-buddy .text-link{font-size:.83rem}
.article-faq{margin-top:46px}.article-faq h2{font-size:1.7rem;margin:12px 0 23px}.article-faq details{border-top:1px solid var(--line);padding:19px 0}.article-faq summary{cursor:pointer;color:var(--forest);font-weight:650;line-height:1.6;font-size:1rem}.article-faq p{margin:14px 0 4px;font-size:1rem;color:var(--ink-light);line-height:1.8}.article-end{display:flex;align-items:center;gap:17px;margin-top:45px;padding-block:25px;border-block:1px solid var(--line);margin-bottom:20px}.article-end .author-avatar{width:45px;height:45px;font-size:1.4rem}.article-end .eyebrow{font-size:.55rem;margin-bottom:5px}.article-end strong{color:var(--forest);font-size:.95rem}.article-end p{font-size:.8rem;color:var(--text-muted);margin-top:5px}
@media(max-width:1000px){.article-layout{gap:32px;grid-template-columns:minmax(0,1fr) 230px}.article-header h1{font-size:2.8rem}}
@media(max-width:800px){.article-layout{grid-template-columns:1fr;gap:0}.article-sidebar{display:none}.article-header h1{font-size:2.35rem}.article-mobile-toc{display:block;padding:16px 20px;border:1px solid var(--line);border-radius:7px;margin:25px 0}.article-mobile-toc>summary{cursor:pointer;font-weight:700;color:var(--forest)}.article-header{padding-top:27px}.article-layout{max-width:740px}.article-description{font-size:1.05rem}}
@media(max-width:600px){.article-header{padding-block:22px 25px}.article-breadcrumb{font-size:.7rem;margin-bottom:22px;gap:8px}.article-header h1{font-size:1.95rem;line-height:1.32;margin-top:16px}.article-description{font-size:1rem;line-height:1.75;margin-top:19px}.article-meta{gap:10px 12px;font-size:.72rem;margin-top:23px}.article-meta time{margin-left:42px}.article-header .eyebrow{font-size:.55rem}.article-cover{border-radius:7px}.article-tools{font-size:.68rem;gap:12px;padding-bottom:15px}.article-save{font-size:.76rem;padding:8px 11px;min-height:41px}.article-summary{padding:21px 20px;margin-top:12px}.article-summary p{font-size:.97rem}.article-takeaways{padding:17px 19px}.article-takeaways summary span{display:block;margin:4px 0 0}.article-takeaways ol{font-size:.96rem}.article-faq h2{font-size:1.5rem}.article-end{align-items:flex-start}.article-end p{font-size:.77rem}.article-layout{padding-bottom:45px}}
</style>
