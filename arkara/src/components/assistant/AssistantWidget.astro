---
import type { AssistantMode } from "../../lib/assistant/contracts";
import Icon from "../ui/Icon.astro";
const { initialMode }: { initialMode?: AssistantMode } = Astro.props;
const href = initialMode
  ? `/assistant?mode=${encodeURIComponent(initialMode)}`
  : "/assistant";
---
<div class="assistant-lazy-root" data-assistant-lazy-root>
<a class="assistant-lazy-trigger" href={href} aria-label="Buka asisten kesiapsiagaan Arkara">
<Icon name="komunitas" size={24}/>
</a>
</div>
<style>
.assistant-lazy-root {
  position: fixed;
  right: 22px;
  bottom: 22px;
  z-index: 110;
}
.assistant-lazy-trigger {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  background: var(--forest);
  border: 2px solid var(--surface-raised);
  border-radius: 50%;
  color: var(--surface-raised);
  box-shadow: 0 4px 16px #1f4d2e26;
}
@media (max-width: 600px) {
  .assistant-lazy-root {
    right: 16px;
    bottom: calc(85px + env(safe-area-inset-bottom));
  }
  .assistant-lazy-trigger {
    width: 46px;
    height: 46px;
  }
}
</style>
