---
import { getRelatedPosts, getRelatedPanduan } from "../../lib/content";

interface Props {
  currentSlug: string;
  category?: string;
  contentType: "blog" | "panduan";
}

const { currentSlug, category, contentType } = Astro.props;

let relatedItems: Array<{ title: string; slug: string; category?: string }> =
  [];

if (contentType === "blog") {
  const posts = await getRelatedPosts(currentSlug, category, 3);
  relatedItems = posts.map((post) => ({
    title: post.title,
    slug: `/blog/${post.slug}`,
    category: post.category,
  }));
} else {
  const guides = await getRelatedPanduan(currentSlug, category, 3);
  relatedItems = guides.map((guide) => ({
    title: guide.title,
    slug: `/panduan/${guide.slug}`,
    category: guide.category,
  }));
}
---
{relatedItems.length > 0 && (
  <section class="related-posts" aria-labelledby="related-posts-title">
    <h3 id="related-posts-title" class="related-posts-title">
      <span>
</span>
      {contentType === 'blog' ? 'ARTIKEL TERKAIT' : 'PANDUAN TERKAIT'}
    </h3>

    <div class="related-posts-grid">
      {relatedItems.map((item) => (
        <a href={item.slug} class="card-ink related-post-card">
          <div class="related-post-kicker">{item.category || 'MANDIRI'}</div>
          <h4 class="related-post-title">{item.title}</h4>
          <div class="related-post-action">BACA SEKARANG</div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
.related-posts {
  margin-top: 45px;
  padding-top: 30px;
  border-top: 1px solid var(--line);
}
.related-posts-title {
  font-size: 1.1rem;
  margin-bottom: 22px;
  letter-spacing: 0;
  color: var(--forest);
}
.related-posts-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}
.related-post-card {
  display: block;
  background: var(--forest-soft);
  padding: 20px;
  border: 1px solid var(--line);
  border-radius: 7px;
  transition: border-color 0.2s;
}
.related-post-card:hover {
  border-color: #9bac8b;
}
.related-post-kicker {
  font: 600 0.6rem var(--font-mono);
  color: var(--forest);
  letter-spacing: 0.07em;
  text-transform: uppercase;
  margin-bottom: 9px;
}
.related-post-title {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--forest);
  letter-spacing: -0.015em;
  text-wrap: pretty;
}
.related-post-action {
  font-size: 0.78rem;
  color: var(--forest);
  margin-top: 13px;
  font-weight: 650;
}
</style>
