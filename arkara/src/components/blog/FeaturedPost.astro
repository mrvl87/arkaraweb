---
import OptimizedImage from "../ui/OptimizedImage.astro";
import Icon from "../ui/Icon.astro";
interface Props {
  post: any;
  categoryLabel: string;
}
const { post, categoryLabel } = Astro.props;
const image = post.banner_image || post.cover_image || post.thumbnail_image;
---
<article class="featured-post">
 <a href={`/blog/${post.slug}`} class="featured-post-image" tabindex="-1" aria-hidden="true">{image&&<OptimizedImage image={image} alt="" class="w-full h-full object-cover" aspectRatio="aspect-video" loading="eager" fetchpriority="high" sizes="(max-width: 768px) 100vw, 60vw" targetWidths={[640,960,1200]}/>}</a>
 <div class="featured-post-copy">
<div class="eyebrow">
<span class="eyebrow-dot">
</span>{categoryLabel} · SOROTAN</div>
<h2>
<a href={`/blog/${post.slug}`}>{post.title}</a>
</h2>{post.description&&<p>{post.description}</p>}<a href={`/blog/${post.slug}`} class="text-link">Baca selengkapnya <Icon name="arrow" size={18}/>
</a>
</div>
</article>
