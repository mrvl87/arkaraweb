---
import OptimizedImage from "../ui/OptimizedImage.astro";
import Icon from "../ui/Icon.astro";
import { calculateReadingTime } from "../../lib/markdown";
interface Props {
  title: string;
  excerpt: string;
  category: string;
  date: string;
  slug: string;
  content?: string;
  image?: any;
  sizes?: string;
  readingTime?: number;
}
const {
  title,
  excerpt,
  category,
  date,
  slug,
  content,
  image,
  sizes,
  readingTime: provided,
} = Astro.props;
const readingTime = content?.trim()
  ? calculateReadingTime(content)
  : provided && provided > 1
    ? provided
    : undefined;
const parsedDate = new Date(date);
const formattedDate = !Number.isNaN(parsedDate.getTime())
  ? parsedDate.toLocaleDateString("id-ID", {
      day: "numeric",
      month: "short",
      year: "numeric",
    })
  : "";
---
<article class="post-card">
 <a href={`/blog/${slug}`} class="post-card-image" tabindex="-1" aria-hidden="true">{image?<OptimizedImage image={image} alt="" class="w-full h-full object-cover" aspectRatio="aspect-video" sizes={sizes||'(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw'} targetWidths={[400,640,800]} mobileTargetWidths={[400,640]} mobileMaxSrcSetWidth={640} quality={78}/>:<div class="image-placeholder">
<Icon name="journal" size={40}/>
</div>}</a>
 <div class="post-card-body">
<div class="card-meta">
<span class="category-label">{category||'Wawasan'}</span>{formattedDate&&<time datetime={date}>{formattedDate}</time>}</div>
 <h3>
<a href={`/blog/${slug}`}>{title}</a>
</h3>
 {excerpt&&<p class="post-card-excerpt">{excerpt}</p>}
 <div class="post-card-footer">{readingTime?<span class="reading-time">
<Icon name="clock" size={14}/>{readingTime} menit baca</span>:<span class="reading-time">Jurnal Arkara</span>}<a href={`/blog/${slug}`} class="text-link" aria-label={`Baca: ${title}`}>Baca artikel <Icon name="arrow" size={16}/>
</a>
</div>
</div>
</article>
