---
interface Props {
  headings?: any[];
  compact?: boolean;
  class?: string;
}
const { headings = [], compact = false } = Astro.props;
---
{headings.length>0&&<nav class:list={['reader-toc',{'reader-toc--compact':compact}]} aria-label="Daftar isi artikel">{!compact&&<>
<div class="eyebrow">DALAM BACAAN INI</div>
<h2>Daftar isi</h2>
</>}<ol>{headings.map(heading=>
<li class:list={{'toc-subheading':heading.depth===3}}>
<a href={`#${heading.slug||heading.id}`} data-toc-link data-heading-text={heading.text}>{heading.text}</a>
</li>)}</ol>
</nav>}
<style>
.reader-toc {
  padding: 24px 22px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--surface-raised);
}
.reader-toc .eyebrow {
  font-size: 0.55rem;
}
.reader-toc h2 {
  font-size: 1.2rem;
  margin-top: 10px;
}
.reader-toc ol {
  display: grid;
  gap: 0;
  list-style: none;
  padding: 0;
  margin: 18px 0 0;
}
.reader-toc li + li {
  border-top: 1px solid #e7e8df;
}
.reader-toc a {
  display: block;
  font-size: 0.85rem;
  line-height: 1.6;
  color: var(--text-muted);
  padding: 11px 0;
}
.reader-toc a:hover,
.reader-toc a[aria-current] {
  color: var(--forest);
  text-decoration: underline;
  text-underline-offset: 3px;
}
.reader-toc .toc-subheading {
  padding-left: 15px;
}
.reader-toc--compact {
  border: 0;
  background: transparent;
  border-radius: 0;
  padding: 0;
}
.reader-toc--compact ol {
  margin-top: 13px;
}
.reader-toc--compact a {
  font-size: 0.9rem;
}
</style>
<script>
const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
const normalize = (value: string) =>
  value.replace(/\s+/g, " ").trim().toLowerCase();
links.forEach((link) => {
  const hash = link.getAttribute("href") || "";
  if (!hash.startsWith("#")) return;
  let target: HTMLElement | null = null;
  try {
    target = document.getElementById(decodeURIComponent(hash.slice(1)));
  } catch {
    /* Preserve browser anchor behavior. */
  }
  if (!target) {
    target =
      [
        ...document.querySelectorAll<HTMLElement>(
          ".prose-arkara h2,.prose-arkara h3",
        ),
      ].find(
        (h) =>
          normalize(h.textContent || "") ===
          normalize(link.dataset.headingText || ""),
      ) || null;
    if (target?.id) link.href = "#" + encodeURIComponent(target.id);
  }
});
</script>
