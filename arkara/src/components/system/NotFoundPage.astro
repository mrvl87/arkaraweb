---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../ui/Icon.astro";
interface Props {
  pageTitle: string;
  pageDescription: string;
  message: string;
  fallbackHref?: string;
  fallbackLabel?: string;
  homeHref?: string;
  homeLabel?: string;
  codeLabel?: string;
  mascotImage?: any;
  mascotAlt?: string;
}
const {
  pageTitle,
  pageDescription,
  message,
  fallbackHref = "/",
  fallbackLabel = "beranda",
  homeHref = "/",
  homeLabel = "Kembali ke beranda",
  codeLabel = "404",
  mascotImage = "/brand/arkara-guide.webp",
  mascotAlt = "Pemandu Arkara",
} = Astro.props;
const mascotUrl =
  typeof mascotImage === "string" ? mascotImage : mascotImage?.url;
---
<BaseLayout title={pageTitle} description={pageDescription} robots="noindex, nofollow">
 <section class="site-container notfound-layout">
<div>
<div class="eyebrow">RUTE BARU, PENGETAHUAN YANG SAMA</div>
<span class="notfound-code">{codeLabel}</span>
<h1>{pageTitle}</h1>
<p>{message}</p>
<div class="notfound-actions">
<a class="button button-primary" href={homeHref}>{homeLabel}<Icon name="arrow" size={18}/>
</a>
<button class="button button-outline" type="button" data-back-button data-fallback-href={fallbackHref}>Halaman sebelumnya</button>
</div>
<p class="notfound-note">Anda tetap bisa melanjutkan perjalanan dari {fallbackLabel}.</p>
</div>
<div class="notfound-visual">{mascotUrl&&<img src={mascotUrl} alt={mascotAlt} width="300" height="400" loading="eager"/>}</div>
</section>
 <script>
document.querySelectorAll<HTMLElement>("[data-back-button]").forEach((button) =>
  button.addEventListener("click", () => {
    if (window.history.length > 1) window.history.back();
    else window.location.assign(button.dataset.fallbackHref || "/");
  }),
);
</script>
</BaseLayout>
<style>
.notfound-layout {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 60px;
  align-items: center;
  padding-block: 70px;
}
.notfound-code {
  display: block;
  font: 800 5rem/1.2 var(--font-display);
  color: var(--amber);
  margin: 17px 0;
}
.notfound-layout h1 {
  font-size: 2.6rem;
}
.notfound-layout p {
  font-size: 1.05rem;
  color: var(--text-muted);
  max-width: 500px;
  margin-top: 20px;
}
.notfound-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 27px;
}
.notfound-layout .notfound-note {
  font-size: 0.85rem;
}
.notfound-visual {
  position: relative;
  display: flex;
  justify-content: center;
  background: var(--forest-soft);
  border-radius: 50%;
  padding: 20px;
}
.notfound-visual img {
  height: 390px;
  width: auto;
  object-fit: contain;
}
@media (max-width: 700px) {
  .notfound-layout {
    grid-template-columns: 1fr;
    padding-block: 40px;
    gap: 30px;
  }
  .notfound-layout h1 {
    font-size: 2rem;
  }
  .notfound-code {
    font-size: 4rem;
  }
  .notfound-visual {
    max-width: 280px;
    margin: auto;
  }
  .notfound-visual img {
    height: 290px;
  }
}
</style>
