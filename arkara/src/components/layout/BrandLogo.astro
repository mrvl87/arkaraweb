---
interface Props {
  inverse?: boolean;
  compact?: boolean;
}
const { inverse = false, compact = false } = Astro.props;
---
<span class:list={['brand-logo', { 'brand-logo--inverse': inverse, 'brand-logo--compact': compact }]}>
  <svg viewBox="0 0 96 64" fill="none" aria-hidden="true">
<path d="M48 2 94 60 70 56 49 25 40 38 34 31 19 54 2 60 48 2Z" fill="currentColor"/>
<path d="m48 31 18 21-16-7-9 9-15 2 15-20 7 8 6-7" fill="currentColor"/>
<path d="M31 62c10-11 25-15 36-20 7-4 4-7-3-10 18 3 22 10 10 16-8 4-19 7-26 14H31Z" fill="#F59E0B"/>
</svg>
  {!compact && <span class="brand-wordmark">
<strong>ARKARA</strong>
<span>SURVIVE WITH KNOWLEDGE</span>
</span>}
</span>
