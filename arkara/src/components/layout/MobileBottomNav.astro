---
interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
---

<nav class="mobile-bottom-nav" aria-label="Navigasi bawah">
  <a href="/" class={currentPath === '/' ? 'active' : ''} aria-label="Beranda"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1v-9.5Z" /></svg><span>Beranda</span></a>
  <a href="/blog" class={currentPath.startsWith('/blog') ? 'active' : ''} aria-label="Artikel"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h9l3 3v15H6V3Z" /><path d="M14 3v4h4M8.5 11h7M8.5 15h7" /></svg><span>Artikel</span></a>
  <a href="/#mobile-search" aria-label="Cari"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg><span>Cari</span></a>
  <a href="/panduan" class={currentPath.startsWith('/panduan') ? 'active' : ''} aria-label="Panduan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Z" /><path d="M4 5.5A2.5 2.5 0 0 1 6.5 8H20" /></svg><span>Panduan</span></a>
  <a href="/login" class={currentPath.startsWith('/login') ? 'active' : ''} aria-label="Profil"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4" /><path d="M4.5 21a7.5 7.5 0 0 1 15 0" /></svg><span>Profil</span></a>
</nav>

<style>
  .mobile-bottom-nav { display: none; }
  @media (max-width: 768px) {
    .mobile-bottom-nav { position: fixed; left: 0; right: 0; bottom: 0; z-index: 120; display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.2rem; padding: 0.55rem 0.75rem calc(0.65rem + env(safe-area-inset-bottom)); border-top: 1px solid rgba(255,255,255,0.12); background: rgba(7,11,12,0.94); backdrop-filter: blur(18px); }
    .mobile-bottom-nav a { display: grid; justify-items: center; gap: 0.25rem; color: #e2e8f0; font-size: 0.68rem; text-decoration: none; line-height: 1; }
    .mobile-bottom-nav a.active { color: #63d2b5; }
    .mobile-bottom-nav svg { width: 1.45rem; height: 1.45rem; }
    .mobile-bottom-nav span { font-family: 'Barlow', system-ui, sans-serif; font-weight: 500; }
  }
</style>
