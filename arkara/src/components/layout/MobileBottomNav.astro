---
import Icon from "../ui/Icon.astro";
interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
const links = [
  { href: "/", label: "Beranda", icon: "home", active: currentPath === "/" },
  {
    href: "/blog",
    label: "Jurnal",
    icon: "journal",
    active: currentPath.startsWith("/blog"),
  },
  {
    href: "/panduan",
    label: "Panduan",
    icon: "book",
    active: currentPath.startsWith("/panduan"),
  },
  { href: "/#mobile-search", label: "Cari", icon: "search", active: false },
];
---
<nav class="mobile-bottom-nav" aria-label="Navigasi bawah">{links.map(link=>
<a href={link.href} class:list={{active:link.active}} aria-current={link.active?'page':undefined}>
<Icon name={link.icon} size={21}/>
<span>{link.label}</span>
</a>)}</nav>
