---
import { getFooterData } from '../../lib/content';

const footerData = await getFooterData();
const footerTagline = footerData?.tagline?.trim() || 'Membangun ketangguhan bangsa melalui pengetahuan yang bisa diakses dan dipraktekkan siapa saja.';
const footerCopyright = footerData?.copyright_text?.trim() || 'Copyright 2026 ARKARA - SURVIVE WITH KNOWLEDGE';
const buildLabel = import.meta.env.PUBLIC_BUILD_LABEL || 'CLOUDFLARE DEPLOY';

function normalizePlatform(platform?: string) { return platform === 'twitter' ? 'x' : platform; }
function getSocialCode(platform?: string) {
  switch (normalizePlatform(platform)) {
    case 'facebook': return 'FB'; case 'youtube': return 'YT'; case 'instagram': return 'IG';
    case 'x': return 'X'; case 'reddit': return 'RD'; case 'tiktok': return 'TT'; default: return null;
  }
}
function getSocialLabel(platform?: string) {
  switch (normalizePlatform(platform)) {
    case 'facebook': return 'Facebook'; case 'youtube': return 'YouTube'; case 'instagram': return 'Instagram';
    case 'x': return 'X'; case 'reddit': return 'Reddit'; case 'tiktok': return 'TikTok'; default: return 'Social';
  }
}
function isValidHttpUrl(url?: string) {
  if (!url) return false;
  try {
    const parsed = new URL(url);
    return parsed.protocol === 'http:' || parsed.protocol === 'https:';
  } catch {
    return false;
  }
}
const footerSocialLinks = (footerData?.social_links ?? [])
  .map((link) => ({ platform: normalizePlatform(link?.platform), url: typeof link?.url === 'string' ? link.url.trim() : '' }))
  .filter((link) => getSocialCode(link.platform) && isValidHttpUrl(link.url));
---

<footer style="background:var(--ink);border-top:3px solid var(--green-terminal);padding:3rem 2rem;position:relative;z-index:2;">
  <div style="max-width:1200px;margin:0 auto;">
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:3rem;margin-bottom:2.5rem;" class="footer-grid">
      <div>
        <div style="font-family:'Share Tech Mono',monospace;font-size:0.6rem;letter-spacing:0.25em;color:var(--green-terminal);text-transform:uppercase;margin-bottom:0.75rem;">ARKARA_OS v2.0</div>
        <p style="font-family:'Special Elite',cursive;font-size:1.5rem;color:var(--cream);margin-bottom:0.75rem;line-height:1.2;">Survive with Knowledge</p>
        <p style="font-size:0.8rem;color:var(--warm-grey);line-height:1.65;max-width:240px;">{footerTagline}</p>
        {footerSocialLinks.length > 0 && (
          <div style="margin-top:1.25rem;">
            <div style="font-family:'Share Tech Mono',monospace;font-size:0.55rem;letter-spacing:0.2em;color:var(--green-terminal);text-transform:uppercase;margin-bottom:0.75rem;">JARINGAN</div>
            <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
              {footerSocialLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={getSocialLabel(link.platform)} title={getSocialLabel(link.platform)} class="footer-social-link">{getSocialCode(link.platform)}</a>)}
            </div>
          </div>
        )}
      </div>
      <div>
        <div style="font-family:'Share Tech Mono',monospace;font-size:0.58rem;letter-spacing:0.2em;color:var(--green-terminal);text-transform:uppercase;margin-bottom:1.25rem;display:flex;align-items:center;gap:0.5rem;"><span style="display:inline-block;width:8px;height:1px;background:var(--green-terminal)"></span>NAVIGASI</div>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.6rem;"><li><a href="/" class="footer-nav-link">Beranda</a></li><li><a href="/blog" class="footer-nav-link">Artikel Blog</a></li><li><a href="/panduan" class="footer-nav-link">Panduan Teknis</a></li></ul>
      </div>
      <div>
        <div style="font-family:'Share Tech Mono',monospace;font-size:0.58rem;letter-spacing:0.2em;color:var(--green-terminal);text-transform:uppercase;margin-bottom:1.25rem;display:flex;align-items:center;gap:0.5rem;"><span style="display:inline-block;width:8px;height:1px;background:var(--green-terminal)"></span>STATUS SISTEM</div>
        <div style="display:flex;flex-direction:column;gap:0.5rem;">
          <div style="font-family:'Share Tech Mono',monospace;font-size:0.65rem;color:var(--warm-grey);display:flex;align-items:center;gap:0.5rem;"><span style="width:6px;height:6px;background:var(--green-terminal);border-radius:50%;animation:pulse-dot 2s infinite;flex-shrink:0;"></span>DATABASE: ONLINE</div>
          <div style="font-family:'Share Tech Mono',monospace;font-size:0.65rem;color:var(--warm-grey);display:flex;align-items:center;gap:0.5rem;"><span style="width:6px;height:6px;background:var(--green-terminal);border-radius:50%;animation:pulse-dot 2s infinite 0.4s;flex-shrink:0;"></span>KONTEN: TERSEDIA</div>
          <div style="font-family:'Share Tech Mono',monospace;font-size:0.65rem;color:var(--warm-grey);display:flex;align-items:center;gap:0.5rem;"><span style="width:6px;height:6px;background:var(--yellow-manual);border-radius:50%;flex-shrink:0;"></span>QR PANDUAN: AKTIF</div>
        </div>
      </div>
    </div>
    <div style="border-top:1px solid rgba(143,175,143,0.15);padding-top:1.5rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
      <p style="font-family:'Share Tech Mono',monospace;font-size:0.6rem;letter-spacing:0.1em;color:var(--warm-grey-dark);">{footerCopyright}</p>
      <p aria-hidden="true" style="display:none;font-family:'Share Tech Mono',monospace;font-size:0.6rem;letter-spacing:0.1em;color:var(--warm-grey-dark);">Copyright 2026 ARKARA - SURVIVE WITH KNOWLEDGE</p>
      <p style="font-family:'Share Tech Mono',monospace;font-size:0.6rem;letter-spacing:0.1em;color:var(--warm-grey-dark);">BUILD: {buildLabel}</p>
    </div>
  </div>
</footer>

<style>
  .footer-social-link { display:inline-flex;align-items:center;justify-content:center;min-width:38px;height:32px;padding:0 0.6rem;border:1px solid rgba(143,175,143,0.35);color:var(--cream-dark);text-decoration:none;font-family:'Share Tech Mono',monospace;font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;background:rgba(143,175,143,0.05);transition:background 0.15s,color 0.15s,border-color 0.15s; }
  .footer-social-link:hover,.footer-social-link:focus-visible { background:var(--green-dark);color:var(--green-terminal);border-color:var(--green-terminal); }
  .footer-nav-link { font-family:'Share Tech Mono',monospace;font-size:0.7rem;letter-spacing:0.1em;color:var(--warm-grey);text-decoration:none;text-transform:uppercase;transition:color 0.15s; }
  .footer-nav-link:hover,.footer-nav-link:focus-visible { color:var(--green-terminal); }
  .footer-social-link:focus-visible,.footer-nav-link:focus-visible { outline:2px solid var(--green-terminal);outline-offset:2px; }
  @media (max-width: 768px) { footer { display:none !important; } }
</style>
