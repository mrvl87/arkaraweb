---
import BrandLogo from "./BrandLogo.astro";
import Icon from "../ui/Icon.astro";
import { getFooterData } from "../../lib/content";
const data = await getFooterData();
const socialLinks = (data?.social_links ?? []).filter((link: any) => {
  try {
    return ["https:", "http:"].includes(new URL(link.url).protocol);
  } catch {
    return false;
  }
});
---
<footer class="site-footer">
 <div class="site-container footer-main">
  <div class="footer-about">
<a href="/" aria-label="Arkara — Beranda">
<BrandLogo inverse />
</a>
<p>Pengetahuan untuk menghadapi ketidakpastian.<br/>Langkah kecil hari ini, ketangguhan untuk esok.</p>
<span class="footer-motto">Siap sebelum perlu.</span>
</div>
  <div>
<h2>Jelajahi Arkara</h2>
<a href="/blog">Jurnal &amp; wawasan</a>
<a href="/panduan">Panduan praktis</a>
<a href="/panduan?category=komunitas">Ketangguhan komunitas</a>
</div>
  <div>
<h2>Mulai dari yang penting</h2>
<a href="/panduan?category=air">Air bersih</a>
<a href="/panduan?category=energi">Energi cadangan</a>
<a href="/panduan?category=pangan">Persediaan pangan</a>
</div>
  <div class="footer-community">
<h2>Bersiap, bersama.</h2>
<p>Kesiapsiagaan dimulai dari rumah dan tumbuh bersama komunitas.</p>{socialLinks.map((link:any)=>
<a href={link.url} target="_blank" rel="noopener noreferrer" class="footer-social">{link.platform === 'facebook'?'Ikuti di Facebook':link.platform} <Icon name="arrow" size={15}/>
</a>)}</div>
 </div>
 <div class="site-container footer-bottom">
<span>© {new Date().getFullYear()} Arkara. Survive with Knowledge.</span>
<span>Praktis. Inklusif. Tangguh.</span>
</div>
</footer>
