---
import SearchAutosuggest from "../SearchAutosuggest.astro";
import BrandLogo from "./BrandLogo.astro";
import Icon from "../ui/Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
const currentPath = Astro.url.pathname;
const links = [
  { label: "Beranda", href: "/" },
  { label: "Jurnal", href: "/blog" },
  { label: "Panduan", href: "/panduan" },
];
---
<div class="utility-bar">
<div class="site-container">
<span>Pengetahuan praktis. Keluarga lebih siap.</span>
<span>Siap sebelum perlu.</span>
</div>
</div>
<header class="site-header">
 <div class="site-container header-inner">
  <a class="site-brand" href="/" aria-label="Arkara — Beranda">
<BrandLogo />
</a>
  <nav class="desktop-navigation" aria-label="Navigasi utama">{links.map(link => <a href={link.href} aria-current={(link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href)) ? 'page' : undefined}>{link.label}</a>)}</nav>
  <div class="header-search">
<SearchAutosuggest variant="desktop" placeholder="Cari pengetahuan..." />
</div>
  <a href="/panduan" class="button button-primary header-cta">Mulai bersiap <Icon name="arrow" size={16}/>
</a>
  <a class="header-mobile-action icon-button" href="/#mobile-search" aria-label="Cari konten Arkara">
<Icon name="search" size={22}/>
</a>
  <ThemeToggle />
 </div>
</header>
