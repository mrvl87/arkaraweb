---
import { getPublishedPanduan } from "../../lib/content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/ui/Icon.astro";
const categories = [
  {
    slug: "air",
    label: "Air bersih",
    description: "Simpan, hemat, dan olah air.",
  },
  {
    slug: "energi",
    label: "Energi",
    description: "Cadangan daya dan bahan bakar.",
  },
  {
    slug: "pangan",
    label: "Pangan",
    description: "Persediaan dan kemandirian pangan.",
  },
  {
    slug: "medis",
    label: "Medis",
    description: "Kesiapan pertolongan pertama.",
  },
  {
    slug: "keamanan",
    label: "Keamanan",
    description: "Perlindungan diri dan keluarga.",
  },
  {
    slug: "komunitas",
    label: "Komunitas",
    description: "Bersiap dan bertahan bersama.",
  },
];
const requestedCategory = Astro.url.searchParams.get("category");
const selected = categories.find((c) => c.slug === requestedCategory);
const guides = await getPublishedPanduan({ category: selected?.slug });
---
<BaseLayout title={selected?`Panduan ${selected.label}`:'Panduan Praktis'} description="Panduan kesiapsiagaan praktis untuk air, energi, pangan, medis, keamanan, dan komunitas.">
 <header class="listing-hero">
<div class="site-container">
<div class="eyebrow">BUKU PEGANGAN KEHIDUPAN TANGGUH</div>
<h1>Pengetahuan jadi <span class="text-forest">tindakan.</span>
</h1>
<p>Langkah yang bisa dipraktikkan. Persiapan yang masuk akal. Temukan panduan untuk kebutuhan keluarga Anda.</p>
</div>
</header>
 <section class="site-container section-space guide-directory" aria-label="Direktori panduan">
 <nav class="category-filters" aria-label="Filter kategori panduan">
<a href="/panduan" class:list={['category-filter',{active:!selected}]} aria-current={!selected?'page':undefined}>
<Icon name="book" size={18}/>Semua panduan</a>{categories.map(c=>
<a href={`/panduan?category=${c.slug}`} class:list={['category-filter',{active:selected?.slug===c.slug}]} aria-current={selected?.slug===c.slug?'page':undefined}>
<Icon name={c.slug} size={18}/>{c.label}</a>)}</nav>
 <div class="section-heading">
<div>
<span class="eyebrow">SELANGKAH LEBIH SIAP</span>
<h2>{selected?selected.label:'Semua panduan'}</h2>
</div>
<span class="section-count">{guides.length} panduan</span>
</div>
 {guides.length>0?<div class="guide-grid">{guides.map((guide,index)=>{const category=categories.find(c=>c.slug===guide.category);return <a href={`/panduan/${guide.slug}`} class="guide-card">
<div class="guide-card-top">
<span class="topic-icon">
<Icon name={guide.category||'book'} size={25}/>
</span>
<span class="guide-number">{String(index+1).padStart(2,'0')}</span>
</div>
<span class="category-label">{category?.label||'Panduan praktis'}</span>
<h2>{guide.title}</h2>
<span class="guide-card-action">Pelajari panduan <Icon name="arrow" size={18}/>
</span>
</a>;})}</div>:<div class="empty-state">
<Icon name={selected?.slug||'book'} size={40}/>
<h2>Panduan sedang disiapkan.</h2>
<p>Lihat topik lain untuk memulai persiapan Anda.</p>
<a href="/panduan" class="button button-primary">Semua panduan</a>
</div>}
 </section>
</BaseLayout>
