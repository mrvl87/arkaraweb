---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchAutosuggest from "../components/SearchAutosuggest.astro";
import PostCard from "../components/blog/PostCard.astro";
import FeaturedPost from "../components/blog/FeaturedPost.astro";
import Icon from "../components/ui/Icon.astro";
import StaticHeroMascot from "../components/home/StaticHeroMascot.astro";
import { getHeroMascot } from "../lib/hero-media";
import { getRecentPosts, getHeroSection } from "../lib/content";
// Set response headers on the route itself, before any layout starts streaming.
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('CDN-Cache-Control', 'no-store');
const [posts, hero] = await Promise.all([getRecentPosts(5), getHeroSection()]);
const mascot = getHeroMascot(hero?.mascot_image);
const mascotSpeech = hero?.mascot_speech_text?.trim();
const mascotTagline = hero?.mascot_tagline?.trim() || "Teman perjalanan menuju hidup yang lebih tangguh.";
const featured = posts[0];
const categories = [
  {
    slug: "air",
    name: "Air bersih",
    description: "Setiap tetes berarti.",
    detail: "Penyimpanan & pengolahan",
  },
  {
    slug: "energi",
    name: "Energi",
    description: "Tetap berdaya.",
    detail: "Listrik & bahan bakar",
  },
  {
    slug: "pangan",
    name: "Pangan",
    description: "Dapur tetap hidup.",
    detail: "Persediaan & pangan mandiri",
  },
  {
    slug: "medis",
    name: "Medis",
    description: "Siap menolong.",
    detail: "Kesehatan & pertolongan pertama",
  },
  {
    slug: "keamanan",
    name: "Keamanan",
    description: "Lindungi yang berarti.",
    detail: "Perlindungan & evakuasi",
  },
  {
    slug: "komunitas",
    name: "Komunitas",
    description: "Lebih kuat bersama.",
    detail: "Kerja sama & rencana keluarga",
  },
];
---
<BaseLayout title="Kesiapsiagaan dimulai dari rumah" description="Arkara membantu keluarga Indonesia lebih siap menghadapi ketidakpastian. Jelajahi panduan air, energi, pangan, medis, keamanan, dan komunitas." preloadImage={mascot.src} cachePolicy="none">
 <section class="home-hero">
  <div class="site-container hero-grid">
   <div class="hero-copy">
<div class="eyebrow">
<span class="eyebrow-dot">
</span>PENGETAHUAN UNTUK HIDUP LEBIH TANGGUH</div>
<h1>Siap sebelum<br/>
<span class="hero-headline-accent">perlu.</span>
</h1>
<p>Kita tidak bisa memilih kapan krisis datang.<br class="desktop-break"/> Tapi kita bisa memilih untuk lebih siap.</p>
<p class="hero-description">Panduan praktis dan pengetahuan tepercaya untuk membangun ketangguhan diri, keluarga, dan komunitas. Mulai dari langkah kecil, hari ini.</p>
<div class="hero-actions">
<a href="/panduan" class="button button-primary">Mulai bersiap <Icon name="arrow" size={18}/>
</a>
<a href="/blog" class="button button-outline">Jelajahi jurnal <Icon name="journal" size={18}/>
</a>
</div>
<div class="hero-footnote">
<span class="hero-check">
<Icon name="check" size={14}/>
</span>Praktis untuk keseharian. Berguna saat keadaan berubah.</div>
</div>
   <div class="hero-visual">
<div class="hero-orbit" aria-hidden="true">
</div>
<div class="hero-contour" aria-hidden="true">
</div>
<div class="hero-note">
<span class="hero-note-icon">
<Icon name="keamanan" size={21}/>
</span>
{mascotSpeech ? <span>{mascotSpeech}</span> : <span>Bukan panik.<br/>
<strong>Punya persiapan.</strong>
</span>}
</div>
<StaticHeroMascot image={hero?.mascot_image} />
<div class="hero-stamp">
<span>ARKARA</span>
<strong>READY<br/>TOGETHER</strong>
<Icon name="check" size={16}/>
</div>
<span class="hero-caption">{mascotTagline}</span>
</div>
  </div>
 </section>
 <div class="values-strip">
<div class="site-container">
<span>
<Icon name="keamanan" size={18}/>Kesiapsiagaan, bukan ketakutan.</span>
<span>
<Icon name="book" size={18}/>Pengetahuan yang bisa dipraktikkan.</span>
<span>
<Icon name="komunitas" size={18}/>Ketangguhan dimulai bersama.</span>
</div>
</div>
 <div class="site-container mobile-home-search">
<SearchAutosuggest id="mobile-search" variant="mobile" placeholder="Apa yang ingin Anda persiapkan?" />
</div>
 <section class="site-container section-space topics-section">
<div class="section-heading">
<div>
<span class="eyebrow">ENAM PILAR KETANGGUHAN</span>
<h2>Mulai dari yang paling penting.</h2>
</div>
<p>Kebutuhan dasar. Pengetahuan yang bertahan.</p>
</div>
<div class="topic-grid">{categories.map((cat,index)=>
<a href={`/panduan?category=${cat.slug}`} class="topic-card">
<div class="topic-card-top">
<span class="topic-icon">
<Icon name={cat.slug} size={29}/>
</span>
<span class="topic-number">0{index+1}</span>
</div>
<h3>{cat.name}</h3>
<p>{cat.description}</p>
<div class="topic-card-bottom">
<span>{cat.detail}</span>
<Icon name="arrow" size={17}/>
</div>
</a>)}</div>
</section>
 <section class="readiness-section">
<div class="site-container readiness-grid">
<div>
<span class="eyebrow">LANGKAH PERTAMA, DAMPAK NYATA</span>
<h2>Keluarga siap.<br/>Pikiran lebih tenang.</h2>
<p>Tidak perlu langsung memiliki semuanya. Kenali kebutuhan rumah, buat rencana sederhana, dan bangun persiapan sedikit demi sedikit.</p>
<a href="/panduan" class="button button-primary">Temukan panduan pertama Anda <Icon name="arrow" size={18}/>
</a>
</div>
<div class="readiness-checklist">
<div class="checklist-heading">
<span class="topic-icon">
<Icon name="book" size={24}/>
</span>
<div>
<span class="eyebrow">MULAI DARI RUMAH</span>
<h3>Empat langkah kecil hari ini</h3>
</div>
</div>{['Kenali kebutuhan air dan pangan keluarga.','Periksa kotak P3K dan penerangan cadangan.','Sepakati kontak dan titik kumpul darurat.','Pelajari satu keterampilan praktis baru.'].map((text,index)=>
<div class="checklist-row">
<span>{String(index+1).padStart(2,'0')}</span>
<p>{text}</p>
<Icon name="check" size={17}/>
</div>)}<div class="checklist-note">Persiapan terbaik adalah yang mulai dilakukan.</div>
</div>
</div>
</section>
 {featured&&<section class="site-container section-space">
<div class="section-heading">
<div>
<span class="eyebrow">LIHAT LEBIH JAUH</span>
<h2>Di balik kehidupan sehari-hari.</h2>
</div>
<a href="/blog" class="text-link">Semua jurnal <Icon name="arrow" size={18}/>
</a>
</div>
<FeaturedPost post={featured} categoryLabel="Jurnal Arkara"/>
<div class="posts-grid">{posts.slice(1,4).map(post=>
<PostCard title={post.title} excerpt={post.description||''} category={post.category||'Wawasan'} date={post.published_at||''} slug={post.slug} content={post.content} readingTime={post.reading_time} image={post.thumbnail_image||post.cover_image}/>)}</div>
</section>}
 <section class="site-container reading-section" data-reader-section hidden>
<div class="section-heading">
<div>
<span class="eyebrow">PERJALANAN PENGETAHUAN ANDA</span>
<h2>Lanjutkan membaca</h2>
</div>
<span class="section-count">Tersimpan di perangkat ini</span>
</div>
<div class="mobile-continue-list" data-mobile-continue-list>
</div>
</section>
 <section class="site-container home-community">
<div class="community-inner">
<div class="community-mark">
<Icon name="komunitas" size={42}/>
</div>
<div>
<span class="eyebrow">SIAP BERSAMA, TANGGUH BERSAMA</span>
<h2>Ketangguhan itu menular.</h2>
<p>Mulai dari diri sendiri. Bagikan pengetahuan. Bangun keluarga dan lingkungan yang saling menjaga.</p>
</div>
<a href="/panduan?category=komunitas" class="button button-amber">Bangun kesiapan bersama <Icon name="arrow" size={18}/>
</a>
</div>
</section>
 <script>
import { enhanceMobileReadingList } from "../lib/reader-state";
enhanceMobileReadingList();
document.addEventListener("astro:after-swap", enhanceMobileReadingList);
</script>
</BaseLayout>
