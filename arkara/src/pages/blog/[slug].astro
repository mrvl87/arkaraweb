---
import { resolvePublishedPostRoute } from '../../lib/content';
import { renderMarkdown, extractHeadings } from '../../lib/markdown';
import PostLayout from '../../layouts/PostLayout.astro';
import NotFoundPage from '../../components/system/NotFoundPage.astro';

const { slug } = Astro.params;
const resolvedRoute = slug ? await resolvePublishedPostRoute(slug) : { kind: 'not_found' as const };

if (resolvedRoute.kind === 'redirect') {
  Astro.response.status = 301;
  Astro.response.statusText = 'Moved Permanently';
  Astro.response.headers.set('Location', resolvedRoute.location);
}

const post = resolvedRoute.kind === 'post' ? resolvedRoute.post : null;
const postNotFound = resolvedRoute.kind === 'not_found';
const renderedPost = post!;

if (postNotFound) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}

const htmlContent = renderMarkdown(post?.content || '');
const headings = extractHeadings(htmlContent);
---

{resolvedRoute.kind === 'redirect' ? null : postNotFound ? (
  <NotFoundPage
    pageTitle="Artikel Tidak Ditemukan"
    pageDescription="Artikel yang Anda cari tidak tersedia atau sudah dipindahkan."
    message="Slug artikel ini tidak tersedia lagi di publikasi aktif Arkara. Periksa kembali URL atau kembali ke arsip blog."
    fallbackHref="/blog"
    fallbackLabel="Arsip Blog"
    homeHref="/blog"
    homeLabel="Lihat Blog"
  />
) : (
  <PostLayout
    title={renderedPost.meta_title || renderedPost.title}
    description={renderedPost.meta_desc || renderedPost.description}
    publishDate={renderedPost.published_at}
    category="ARKARA JURNAL"
    coverImage={renderedPost.banner_image || renderedPost.cover_image}
    canonicalHref={`/blog/${renderedPost.slug}`}
    headings={headings}
    content={renderedPost.content || ''}
    currentSlug={renderedPost.slug}
    contentType="blog"
    quickAnswer={renderedPost.quick_answer}
    keyTakeaways={renderedPost.key_takeaways || []}
    faq={renderedPost.faq || []}
    editorialFormat={renderedPost.editorial_format || 'legacy'}
  >
    <div set:html={htmlContent} />
  </PostLayout>
)}
