---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAssistantApiBaseUrl } from "../lib/assistant/env";
const apiBaseUrl = getAssistantApiBaseUrl();
---
<BaseLayout cachePolicy="private" title="Asisten Kesiapsiagaan" description="Jelajahi pertanyaan dan susun prioritas kesiapsiagaan bersama asisten Arkara." canonicalHref="/assistant">
 <header class="listing-hero">
<div class="site-container">
<div class="eyebrow">TEMAN MENYUSUN PERSIAPAN</div>
<h1>Mulai dari pertanyaan Anda.</h1>
<p>Diskusikan kebutuhan keluarga, jelajahi skenario, dan susun langkah yang masuk akal bersama asisten Arkara.</p>
</div>
</header>
 <section class="site-container assistant-page">
<div id="assistant-root" data-api-base-url={apiBaseUrl}>
</div>
</section>
 <script>
import { mountAssistantPage } from "../lib/assistant/widget";
const root = document.getElementById("assistant-root");
if (root)
  mountAssistantPage(root, {
    apiBaseUrl: root.getAttribute("data-api-base-url") ?? "",
    assistantPageUrl: "/assistant",
    siteName: "Arkara",
    locale: "id-ID",
  });
</script>
</BaseLayout>
<style>
.assistant-page {
  padding-block: 35px 70px;
}
#assistant-root {
  background: var(--surface-raised);
  border: 1px solid var(--line);
  border-radius: 10px;
  overflow: hidden;
}
</style>
